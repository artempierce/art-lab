# Copy to .env (git-ignored) and fill in.

# Claude API key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# LangSmith tracing: https://smith.langchain.com (set LANGSMITH_TRACING=false if you have no key yet)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=art-lab

# 1 = free fake model (no API calls, $0). 0 = real Claude.
ARTLAB_FAKE_LLM=1
